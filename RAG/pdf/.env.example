# Credenciales de LangSmith para rag_pdf_langsmith.py (observabilidad/tracing).
# Copiá este archivo a .env y completá tu API key real.
#   copy .env.example .env      (Windows)
#
# El .env NUNCA se sube al repo (está en .gitignore). Sin API key el RAG
# funciona igual, pero no registra trazas.

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=ls_reemplazar_por_tu_api_key
LANGSMITH_PROJECT=curso-llm-rag-pdf
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
