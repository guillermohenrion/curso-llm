# Configuracion del RAG + MCP de Jira (rag_mcp_jira.py).
# Copiá este archivo a .env y completá tus valores reales.
#   copy .env.example .env      (Windows)
#
# El .env NUNCA se sube al repo (está en .gitignore).

# Modelo de Ollama con soporte de TOOLS (gemma3 NO sirve para tool-calling).
OLLAMA_TOOL_MODEL=llama3.1

# --- Jira Cloud ---
# URL de tu instancia (termina en .atlassian.net para Cloud).
JIRA_URL=https://tuorg.atlassian.net
# Tu email de Atlassian.
JIRA_USERNAME=tu-email@dominio.com
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=reemplazar_por_tu_api_token
