# Credenciales de Pinecone para el ejemplo rag_pinecone.py.
# Copiá este archivo a .env y completá tu API key real.
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS / Linux)
#
# El archivo .env NUNCA se sube al repo (está en .gitignore).

# API key de Pinecone (https://app.pinecone.io -> API Keys).
PINECONE_API_KEY=pcsk_reemplazar_por_tu_api_key

# Nombre del indice (se crea automaticamente si no existe).
PINECONE_INDEX=curso-llm-rag

# Ubicacion del indice serverless (dejalo asi para el free tier).
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
