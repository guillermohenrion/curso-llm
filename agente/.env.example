# Credenciales para el tracing en LangSmith (opcional, para el agente).
# Copiá este archivo a .env y completá tu API key real.
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS / Linux)
#
# El archivo .env NUNCA se sube al repo (está en .gitignore).
# Sin estas credenciales el agente funciona igual, pero no registra trazas.

# Activa el envio de trazas a LangSmith.
LANGSMITH_TRACING=true

# Tu API key de LangSmith (https://smith.langchain.com -> Settings -> API Keys).
LANGSMITH_API_KEY=ls_reemplazar_por_tu_api_key

# Nombre del proyecto donde se agrupan las trazas (podés cambiarlo).
LANGSMITH_PROJECT=curso-llm-agente

# Endpoint (dejalo asi salvo que uses una instancia self-hosted).
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
