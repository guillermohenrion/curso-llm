# Configuracion del cliente de Langflow (ejecutar_flow_langflow.py).
# Copiá este archivo a .env y completá tus valores reales.
#   copy .env.example .env      (Windows)
#
# El .env NUNCA se sube al repo (está en .gitignore).

# URL donde corre Langflow (por defecto, local).
LANGFLOW_URL=http://127.0.0.1:7860

# ID del flujo armado en la UI (aparece en la URL del editor: .../flow/<FLOW_ID>).
LANGFLOW_FLOW_ID=reemplazar_por_el_id_del_flujo

# API key generada en Settings -> API Keys de Langflow.
LANGFLOW_API_KEY=reemplazar_por_tu_api_key
